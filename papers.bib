@article{cruz2026,
title = {Mist evaporative cooling system with natural ventilation in a semi-outdoor environment: Theoretical models, experiments, and thermal simulations},
journal = {Energy and Buildings},
volume = {366},
pages = {117700},
year = {2026},
issn = {0378-7788},
doi = {https://doi.org/10.1016/j.enbuild.2026.117700},
url = {https://www.sciencedirect.com/science/article/pii/S0378778826007607},
author = {M.V. Cruz-Salas and E. Puerto and J. Rojas and G. Barrios and G. Huelsz and G. Ramírez},
keywords = {Evaporative cooling, Mist, Natural ventilation, Semi-outdoor, Thermodynamic modeling, Energyplus},
abstract = {Semi-outdoor environments in climates with a hot and dry season can achieve comfortable air temperature using mist evaporative cooling systems (MECS). However, assessing their effect using building thermal simulation programs requires a physical model of the MECS operating in combination with natural ventilation in semi-outdoor environments (MECS&NV) that can be implemented in such programs. This research presents, step by step, the development of a thermodynamic model for the MECS&NV process based on psychrometric theory, which can be implemented in EnergyPlus using its Python plug-in system. The developed model was validated against experimental results obtained in a semi-outdoor cafeteria. For the cafeteria air temperature, the mean absolute error is 0.4 ∘C and the mean bias error is 0.1 ∘C. The cooling effect of the MECS on the cafeteria air temperature compared with the value it would have without the MECS has a maximum reduction of 2.9 ∘C and an average of 1.9 ∘C. The developed model can be used to perform future simulations and support decision-making regarding sizing and implementation of this type of evaporative cooling system in semi-outdoor spaces for low-energy buildings.}
}